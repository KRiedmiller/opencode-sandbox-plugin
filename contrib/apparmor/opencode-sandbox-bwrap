# opencode-sandbox: bubblewrap profile for Ubuntu 24.04+ userns restrictions.
#
# Ubuntu sets kernel.apparmor_restrict_unprivileged_userns=1: unprivileged user
# namespaces are only allowed for processes whose AppArmor profile grants
# "userns", and anything unconfined is transitioned to the capability-stripping
# "unprivileged_userns" profile when it creates one.
#
# sandbox-runtime runs apply-seccomp inside bwrap. It creates a NESTED user
# namespace and needs CAP_SYS_ADMIN there for its PID+mount unshare. Without
# this profile that nested creation is capability-restricted and every command
# is blocked by the plugin's fail-closed enforcement probe.
#
# Scope of the grant: only /usr/bin/bwrap and the processes it starts. Children
# inherit this profile (`ix`) because bwrap runs with no_new_privs, which makes
# AppArmor profile transitions impossible (exec transitions fail with
# "no new privs"); stacking (bwrap//&child) can only remove permissions and so
# cannot restore the capability the helper needs. The filesystem and network
# sandbox itself is enforced by bwrap's namespaces and mounts, not by AppArmor.

abi <abi/4.0>,

include <tunables/global>

profile bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,

  # Inherit (not transition) for everything bwrap spawns inside the sandbox.
  allow ix /**,

  include if exists <local/opencode-sandbox-bwrap>
}
